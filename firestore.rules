rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBibliotecario() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'bibliotecario';
    }

    function isLibraryStaff() {
      return isAdmin() || isBibliotecario();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isBibliotecario();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin() ||
        (isBibliotecario() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['libraryMembership']));
      allow delete: if false;

      match /highlights/{highlightId} {
        allow read, write: if isOwner(uid);
      }

      match /verseNotes/{noteId} {
        allow read, write: if isOwner(uid);
      }

      match /studyHighlights/{highlightId} {
        allow read, write: if isOwner(uid);
      }

      match /planProgress/{planId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();

      match /days/{dayId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /devotionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /studies/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /libraryTitles/{id} {
      allow read: if true;
      allow write: if isLibraryStaff();
    }

    match /libraryCopies/{id} {
      allow read: if true;
      allow write: if isLibraryStaff();
    }

    match /libraryMembershipPlans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /libraryLoans/{id} {
      allow read: if isLibraryStaff() || isOwner(resource.data.userId);
      allow create, update, delete: if isLibraryStaff();
    }

    match /libraryReservations/{id} {
      allow read: if isLibraryStaff() || isOwner(resource.data.userId);
      allow create: if isLibraryStaff() || isOwner(request.resource.data.userId);
      // El titular solo puede cancelar su propia reserva; el resto de las transiciones de estado las hace el staff.
      allow update: if isLibraryStaff() ||
        (isOwner(resource.data.userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'cancelado');
      allow delete: if isLibraryStaff();
    }

    match /libraryFines/{id} {
      allow read: if isLibraryStaff() || isOwner(resource.data.userId);
      allow write: if isLibraryStaff();
    }
    match /signupEvents/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Una persona logueada solo puede subir el contador de inscriptos, y únicamente junto con la creación de su
      // propia inscripción en la misma transacción, por exactamente la cantidad de personas que anota.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
        !exists(/databases/$(database)/documents/signupEvents/$(eventId)/registrations/$(request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/signupEvents/$(eventId)/registrations/$(request.auth.uid)) &&
        request.resource.data.registeredCount ==
          resource.data.registeredCount +
          getAfter(/databases/$(database)/documents/signupEvents/$(eventId)/registrations/$(request.auth.uid)).data.totalPeople &&
        (resource.data.capacity == null || request.resource.data.registeredCount <= resource.data.capacity)
      );

      match /registrations/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          request.resource.data.companions.size() <= 30 &&
          request.resource.data.totalPeople == 1 + request.resource.data.companions.size() &&
          (request.resource.data.isGroupLeader == true || request.resource.data.companions.size() == 0);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
